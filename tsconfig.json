{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node"],
    "strict": true, "skipLibCheck": true, "resolveJsonModule": true,
    "esModuleInterop": true, "allowImportingTsExtensions": true, "noEmit": true
  },
  "include": ["src/shared/**/*.ts", "src/client/**/*.ts", "src/server/**/*.ts", "scripts/**/*.ts", "tests/game/**/*.ts", "vite.config.ts", "playwright.config.ts"]
}
