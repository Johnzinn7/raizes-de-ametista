{
  "name": "raizes-de-ametista",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "start": "node --import tsx src/server/index.ts",
    "test": "node node_modules/vitest/vitest.mjs run",
    "validate-levels": "node --import tsx scripts/validate-levels.ts",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "check": "npm run build && npm test && npm run validate-levels",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "review-art": "node --import tsx scripts/review-art.ts",
    "package": "node --import tsx scripts/package.ts"
  },
  "dependencies": {
    "tsx": "^4.23.15",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
